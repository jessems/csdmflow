sys-monitoring -> lm-prod
sys-monitoring -> monitoring
various-tmso -> infra
various-tmso -> various-tms

event-prod -> mid-app
mid-app -> mid-server : Runs On
mid-server -> event-prod : Sends data to
infra -> mid-server : Sends data from

incident-bso -> incident-prod
incident-bso -> service-mgmt
service-mgmt -> end-user


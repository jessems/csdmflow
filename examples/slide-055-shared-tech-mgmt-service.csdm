dir-mgmt -> netiq
dir-mgmt -> ms-ad
dir-mgmt -> openldap
ms-ad -> azure-ad
ms-ad -> ad-prod

ad-admin -> azure-ad
ad-admin -> ad-prod
ad-admin -> identity

ad-prod -> box-prod : Sends Data to
ad-prod -> sn-prod : Sends Data to
ad-prod -> exchange-prod : Sends Data to
ad-prod -> sap-prod : Sends Data to

box -> box-prod
box -> file-sharing

ad-prod -> webproxy
ad-prod -> adfs
ad-prod -> ds1
ad-prod -> aad-connect
webproxy -> serverabc : Runs on
adfs -> server123 : Runs on
ds1 -> server456 : Runs on
aad-connect -> server789 : Runs on

# slide draws Contains only to Serverabc
windows-admin -> serverabc
windows-admin -> compute

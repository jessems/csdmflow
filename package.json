{
  "name": "csdmflow",
  "version": "0.1.0",
  "description": "Text-to-diagram for CSDM service models: write entities and relationships, get a laid-out diagram.",
  "bin": {
    "csdmflow": "bin/csdmflow.js"
  },
  "main": "src/csdm.js",
  "files": [
    "bin",
    "src",
    "dist"
  ],
  "scripts": {
    "test": "node test/smoke.js && node test/labels.js",
    "compare": "node tools/compare.js",
    "images": "node tools/readme-images.js",
    "build": "esbuild src/browser.js --bundle --format=iife --global-name=csdmflow --minify --target=es2019 --outfile=dist/csdmflow.min.js",
    "prepublishOnly": "npm test && npm run build",
    "site": "npm run build && node tools/build-site.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "csdm",
    "cmdb",
    "servicenow",
    "diagram",
    "diagrams-as-code",
    "svg"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessems/csdmflow.git"
  },
  "unpkg": "dist/csdmflow.min.js",
  "jsdelivr": "dist/csdmflow.min.js",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "homepage": "https://jessems.github.io/csdmflow/"
}
